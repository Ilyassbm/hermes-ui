{
  "name": "hermes-ui",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint -c glaze.eslint.config.mjs src",
    "check:css": "node scripts/check-css.mjs",
    "check:menus": "node scripts/check-menus.mjs",
    "check:menu-open": "node scripts/check-menu-open.mjs",
    "check:model-menu": "node scripts/check-model-menu.mjs",
    "check:slash": "node scripts/check-slash.mjs",
    "check:keybinds": "node scripts/check-keybinds.mjs",
    "check:overlay": "node scripts/check-overlay-unmount.mjs",
    "check:takeover": "node scripts/check-takeover.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:iui": "node scripts/check-iui.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:resume": "node scripts/check-resume.mjs",
    "check:iui-skill": "node scripts/gen-iui-skill.mjs --check",
    "gen:iui": "node scripts/gen-iui-skill.mjs",
    "gen:logos": "node scripts/gen-provider-logos.mjs",
    "lint:ui": "node scripts/lint-ui.mjs",
    "check:tools": "node scripts/check-tool-mapping.mjs",
    "check:bots": "/opt/hermes/.venv/bin/python -I scripts/check-bots-api.py",
    "test:files": "/opt/hermes/.venv/bin/python -I dashboard/test_file_routes.py",
    "install-local": "node scripts/build.mjs --install"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "lintapple": "^0.1.24",
    "playwright": "^1.49.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  }
}
