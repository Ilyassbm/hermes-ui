{
  "fonts": [
    "Glaze Sans",
    "Geist",
    "ui-sans-serif",
    "system-ui",
    "-apple-system",
    "Segoe UI",
    "sans-serif",
    "Glaze Mono",
    "Geist Mono",
    "ui-monospace",
    "SF Mono",
    "Menlo",
    "Consolas",
    "monospace"
  ],
  "fontSizes": [10, 11, 12, 13, 14, 16, 20],
  "typeRules": [
    { "selector": "h1", "sizes": [20] },
    { "selector": "h2", "sizes": [12, 13] },
    { "selector": "h3", "sizes": [13] },
    { "selector": "button, [role=button]", "sizes": [12, 13] }
  ],
  "minControlSize": 24,
  "controlSizeRules": [],
  "minControlGap": 8,
  "minControlInset": 8,
  "controlContainers": ["[data-ui-container]"],
  "contentInsetRules": [],
  "iconSizeRules": [],
  "minLayoutGap": 8,
  "bannedCopy": ["unlock your potential", "seamlessly", "game-changing", "supercharge", "unleash"],
  "viewports": [{ "width": 390, "height": 844 }, { "width": 1440, "height": 900 }],
  "colorSchemes": ["dark", "light"],
  "exceptions": [
    {
      "selector": ".hui-row-output",
      "rules": ["content-clipping"],
      "reason": "Two-line preview of the bot's last message in the rail row: a long message is truncated on purpose, and the full text is in the row title and opens the conversation."
    }
  ]
}
